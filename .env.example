# Application settings

# Human-readable application name (used as the FastAPI title)
APP_NAME="Школа — закрытый сайт для учеников"

# Secret key for signing session cookies and hashing invite codes; replace with a long
# random string in production. Changing it invalidates all student sessions and all
# previously issued invite codes.
SECRET_KEY=change-me-to-a-long-random-string

# SQLAlchemy database URL
DATABASE_URL=sqlite:///./school.db

# Enable debug mode. Leave it on for local work over plain HTTP: outside debug mode the
# application warns (in the log, it still starts) when the session cookies are not Secure.
DEBUG=false

# --- Admin authentication ---

# Name of the cookie that stores the admin session token
SESSION_COOKIE_NAME=admin_session

# Admin session lifetime, in hours
ADMIN_SESSION_TTL_HOURS=12

# Send the session cookie only over HTTPS.
# Keep false for local development over plain HTTP; set true in production behind HTTPS.
COOKIE_SECURE=false

# Credentials for the one-off seed script (scripts/seed_admin.py) only.
# They are NOT used by the running application; leave empty if you pass --username/--password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Student authentication ---

# Name of the signed cookie that carries the student session
STUDENT_COOKIE_NAME=student_session

# How long, in days, the browser stores the student cookie. The session itself
# does not expire: the student stays signed in until they log out.
STUDENT_SESSION_COOKIE_DAYS=3650

# Default lifetime, in days, of a newly created invite code
INVITE_TTL_DAYS=14

# Upper bound, in days, on the lifetime an admin may set for a single code
INVITE_TTL_MAX_DAYS=365

# Upper bounds on the login and registration fields. A longer body is refused before it
# reaches a regex, the password hash or the database; the same numbers are rendered as
# maxlength on the forms.
MAX_EMAIL_LENGTH=254
MAX_PASSWORD_LENGTH=128
MAX_INVITE_CODE_INPUT_LENGTH=32
MAX_ADMIN_USERNAME_LENGTH=64

# Minimum number of days between two manual alias changes by the same student.
# The cooldown protects against harassment and keeps a student from "running away"
# from their reputation; the first change is always allowed.
ALIAS_CHANGE_COOLDOWN_DAYS=30

# --- Rate limiting ---

# Sliding-window budgets per student, counted in this process only (in-memory;
# they reset on restart and are not shared between workers). Set a limit to 0 to
# switch the action off; windows are in seconds.
RATE_LIMIT_POSTS=10
RATE_LIMIT_POSTS_WINDOW_SECONDS=3600
RATE_LIMIT_COMMENTS=60
RATE_LIMIT_COMMENTS_WINDOW_SECONDS=3600
RATE_LIMIT_REVIEWS=20
RATE_LIMIT_REVIEWS_WINDOW_SECONDS=3600
RATE_LIMIT_ASSISTANT=30
RATE_LIMIT_ASSISTANT_WINDOW_SECONDS=3600

# Login attempts per client IP, in the same in-memory window. The admin form is strict
# (it guards the moderation tools); the student form is soft. A successful login clears
# the counter. The IP is used only as an in-memory counter key: it is never stored in
# the database or written to a log, and behind a proxy it is the proxy's address.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900
STUDENT_LOGIN_MAX_ATTEMPTS=20
STUDENT_LOGIN_WINDOW_SECONDS=900

# --- Teachers and review criteria ---

# Data file read by scripts/seed_teachers.py: the school's staff and the questions a
# review is scored on. The default path is deliberately outside the repository --
# real names of staff are personal data, and only the demo file with invented names
# is committed (data/teachers.demo.json). If this file does not exist, the script
# falls back to the demo file and says so on stderr.
TEACHERS_DATA_FILE=data/teachers.local.json

# --- Assistant (optional) ---

# The assistant answers from the school's own tables first, and only asks a model
# about what the database cannot answer. Leave both keys empty and nothing ever
# leaves the server: the assistant still works, it just says it does not know.
# Fill one in (Anthropic or DeepSeek) to switch generation on. The question and an
# anonymised context go out; never a pseudonym, a class, an e-mail or a post.
# The key is never written to a log, and neither is the question.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Longest answer the model may produce, and how long to wait for it. The timeout
# is deliberately short: a student waiting on a spinner is worse than an honest
# "I cannot answer right now".
ASSISTANT_MAX_TOKENS=1024
ASSISTANT_TIMEOUT_SECONDS=30

# --- CSRF ---

# Cookie that carries the signed CSRF token, and the hidden form field that must
# echo it. The cookie is httpOnly; the server renders the value into each form.
CSRF_COOKIE_NAME=csrf_token
CSRF_FORM_FIELD=csrf_token
