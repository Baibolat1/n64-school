# Application settings

# Human-readable application name (used as the FastAPI title)
APP_NAME="Школа — закрытый сайт для учеников"

# Secret key for signing session cookies and hashing invite codes; replace with a long
# random string in production. Changing it invalidates all student sessions and all
# previously issued invite codes.
SECRET_KEY=change-me-to-a-long-random-string

# SQLAlchemy database URL
DATABASE_URL=sqlite:///./school.db

# Enable debug mode
DEBUG=false

# --- Admin authentication ---

# Name of the cookie that stores the admin session token
SESSION_COOKIE_NAME=admin_session

# Admin session lifetime, in hours
ADMIN_SESSION_TTL_HOURS=12

# Send the session cookie only over HTTPS.
# Keep false for local development over plain HTTP; set true in production behind HTTPS.
COOKIE_SECURE=false

# Credentials for the one-off seed script (scripts/seed_admin.py) only.
# They are NOT used by the running application; leave empty if you pass --username/--password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Student authentication ---

# Name of the signed cookie that carries the student session
STUDENT_COOKIE_NAME=student_session

# Student session lifetime, in days
STUDENT_SESSION_TTL_DAYS=30

# Default lifetime, in days, of a newly created invite code
INVITE_TTL_DAYS=14

# Minimum number of days between two manual alias changes by the same student.
# The cooldown protects against harassment and keeps a student from "running away"
# from their reputation; the first change is always allowed.
ALIAS_CHANGE_COOLDOWN_DAYS=30

# --- Rate limiting ---

# Sliding-window budgets per student, counted in this process only (in-memory;
# they reset on restart and are not shared between workers). Set a limit to 0 to
# switch the action off; windows are in seconds.
RATE_LIMIT_POSTS=10
RATE_LIMIT_POSTS_WINDOW_SECONDS=3600
RATE_LIMIT_COMMENTS=60
RATE_LIMIT_COMMENTS_WINDOW_SECONDS=3600

# Login attempts per client IP, in the same in-memory window. The admin form is strict
# (it guards the moderation tools); the student form is soft. A successful login clears
# the counter. The IP is used only as an in-memory counter key: it is never stored in
# the database or written to a log, and behind a proxy it is the proxy's address.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900
STUDENT_LOGIN_MAX_ATTEMPTS=20
STUDENT_LOGIN_WINDOW_SECONDS=900

# --- CSRF ---

# Cookie that carries the signed CSRF token, and the hidden form field that must
# echo it. The cookie is httpOnly; the server renders the value into each form.
CSRF_COOKIE_NAME=csrf_token
CSRF_FORM_FIELD=csrf_token
